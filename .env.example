# Скопируй в .env и поправь под себя: cp .env.example .env
# На Этапе 1 реально используются только помеченные [активно] переменные.
# Остальные объявлены заранее, чтобы конфиг не переписывался на каждом этапе.

# --- Приложение --------------------------------------------------------
APP_ENV=dev                       # [активно] dev | staging | prod
LOG_LEVEL=INFO                    # [активно]
LOG_FORMAT=console                # [активно] json | console
SECRET_KEY=dev-insecure-change-me # [активно]

# --- База данных -------------------------------------------------------
POSTGRES_HOST=postgres            # [активно] localhost при запуске без Docker
POSTGRES_PORT=5432                # [активно]
POSTGRES_DB=highlights            # [активно]
POSTGRES_USER=hg                  # [активно]
POSTGRES_PASSWORD=hg-dev-password # [активно]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis / Celery ----------------------------------------------------
REDIS_URL=redis://redis:6379/0            # [активно]
CELERY_BROKER_URL=redis://redis:6379/1    # [активно]
CELERY_RESULT_BACKEND=redis://redis:6379/2 # [активно]
CELERY_TASK_TIME_LIMIT=3600

# --- Хранилище ---------------------------------------------------------
STORAGE_BACKEND=local             # [активно] local | s3
STORAGE_LOCAL_ROOT=/media         # [активно]
S3_ENDPOINT_URL=http://minio:9000 # [активно] адрес, по которому ходит СЕРВЕР
# Адрес, по которому за файлом пойдёт КЛИЕНТ. Если он отличается от
# внутреннего, задать обязательно: хост входит в подпись presigned-ссылки,
# и ссылка, подписанная для minio:9000, при обращении с localhost даст 403.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # [активно]
S3_BUCKET=highlights              # [активно]
S3_ACCESS_KEY=minioadmin          # [активно]
S3_SECRET_KEY=minioadmin          # [активно]
S3_SIGNED_URL_TTL=900             # [активно]

# --- Медиа -------------------------------------------------------------
FFMPEG_BIN=ffmpeg                 # [активно, Этап 8]
FFPROBE_BIN=ffprobe               # [активно]
MAX_UPLOAD_BYTES=21474836480      # [активно] 20 ГиБ
MAX_DURATION_SEC=21600            # [активно] 6 ч
ALLOWED_CONTAINERS=mp4,mkv,mov    # [активно]
UPLOAD_CHUNK_SIZE=33554432        # [активно] 32 МиБ на часть
WORKDIR=/tmp/highlight-generator  # [активно] временные файлы приёма и сборки
# Каталоги, из которых разрешено регистрировать локальные файлы через
# POST /videos/register. Пусто = запрещено отовсюду. Без белого списка
# `file:///etc/passwd` был бы валидным запросом.
LOCAL_SOURCE_ROOTS_RAW=/media/in  # [активно]

# --- Детекция сцен (Этап 3) -------------------------------------------
SCENE_DETECTOR=pyscenedetect       # [активно] pyscenedetect | ffmpeg
SCENE_THRESHOLD=27.0               # [активно] шкала PySceneDetect 0..255
SCENE_MIN_LEN_SEC=1.5              # [активно] короче — сливается с соседней
SCENE_MAX_LEN_SEC=90.0             # [активно] длиннее — дробится принудительно
SCENE_DOWNSCALE=0                  # [активно] 0 = решает детектор
SCENE_KEYFRAMES_ENABLED=true       # [активно] превью-кадр на сцену
SCENE_KEYFRAME_WIDTH=640           # [активно] ширина превью, высота по пропорции
SCENE_KEYFRAME_WORKERS=8           # [активно] параллельных вызовов ffmpeg

# --- Воркеры -----------------------------------------------------------
# Очереди CPU-воркера. По умолчанию он берёт и `gpu`: без видеокарты
# распознавание речи иначе выполнять некому, и джоб зависнет молча.
# Подняли профиль `gpu` — сузьте до cpu,io, иначе задачи будут случайно
# делиться между CPU и GPU, и половина пойдёт впятеро медленнее.
WORKER_CPU_QUEUES=cpu,io,gpu       # [активно]
WORKER_CPU_CONCURRENCY=4           # [активно]

# --- Аудио (Этап 4) ----------------------------------------------------
AUDIO_SAMPLE_RATE=16000            # [активно] формат, на котором обучался Whisper
AUDIO_CHANNELS=1                   # [активно]

# --- Распознавание речи (Этап 4) --------------------------------------
DEVICE=auto                        # [активно] auto | cpu | cuda
HF_HOME=/models
# tiny | base | small | medium | large-v3. Дефолт рассчитан на CPU: на живой
# русской речи medium дал тот же WER, что large-v3, но вдвое быстрее и без
# трёх гигабайт весов. С видеокартой имеет смысл large-v3.
WHISPER_MODEL=medium               # [активно]
WHISPER_COMPUTE_TYPE=auto          # [активно] auto | float16 (GPU) | int8 (CPU)
WHISPER_BEAM_SIZE=5                # [активно]
WHISPER_VAD=true                   # [активно] пропускать тишину, не выдумывая текст
WHISPER_NO_SPEECH_THRESHOLD=0.6    # [активно] выше — сегмент считается не речью
WHISPER_LANGUAGE=                  # [активно] пусто = автоопределение
WHISPER_CHUNK_SEC=600              # [активно] 0 = не резать файл на куски
WHISPER_CHUNK_OVERLAP_SEC=2        # [активно] перекрытие кусков, чтобы не терять слова на стыке
WHISPER_BATCH_SIZE=0               # [активно] 0 = авто (16 на GPU, 1 на CPU)

# --- Анализаторы признаков (Этап 5) -----------------------------------
# Ключи через запятую: audio.loudness, audio.pauses, speech.rate,
# vision.motion, vision.cuts, vision.dynamics. Отключённый анализатор
# не планируется вовсе; если отключить тот, от которого зависит другой,
# план не соберётся — и скажет об этом явно, а не посчитает половину.
ANALYZERS_DISABLED=

# Видеоанализ. Кадры сэмплируются и уменьшаются: разбирать все 25 кадров
# в секунду в полном разрешении незачем — информации о сцене это почти
# не добавляет, а время растёт линейно.
VISION_SAMPLE_FPS=3.0              # [активно] кадров в секунду на анализ
VISION_MAX_SIDE=320                # [активно] длинная сторона кадра при анализе
VISION_DETECT_FRAMES=5             # [активно] кадров на сцену для детекторов лиц и людей

# Звуковые события: смех, крик, аплодисменты, музыка, удары.
# Модель — AudioSet-классификатор (~350 МБ, качается в HF_HOME при первом
# запуске). Окно 10 с — размер входа, на котором она обучалась.
AUDIO_EVENT_MODEL=MIT/ast-finetuned-audioset-10-10-0.4593   # [активно]
AUDIO_EVENT_WINDOW_SEC=10.0        # [активно]
AUDIO_EVENT_MAX_WINDOWS=3          # [активно] окон на сцену; больше — линейно дороже
AUDIO_EVENT_THRESHOLD=0.1          # [активно] ниже — событие не пишется вовсе

# Эмоция в голосе (~380 МБ). На сцену подаётся не вся речь, а первые
# SER_MAX_SPEECH_SEC секунд: эмоция не меняется каждую секунду, а время
# растёт линейно по длине речи.
SER_MODEL=superb/wav2vec2-base-superb-er   # [активно]
SER_MAX_SPEECH_SEC=5.0             # [активно]

# Лица и люди. yunet — 232 КБ весов из HF_HOME; haar — каскад из комплекта
# OpenCV, ничего не качает и работает без сети, но заметно хуже.
FACE_DETECTOR=yunet                # [активно] yunet | haar
FACE_SCORE_THRESHOLD=0.7           # [активно]
# Детектор людей (SSDLite из torchvision, ~14 МБ). Пусто — не считать людей.
PERSON_DETECTOR=ssdlite320_mobilenet_v3_large   # [активно]
PERSON_SCORE_THRESHOLD=0.5         # [активно]

# --- Скоринг (Этап 7+) -------------------------------------------------
DEFAULT_PROFILE=default
SCORE_ALPHA=0.4
SCORE_BETA=0.5
SCORE_GAMMA=0.1

# --- LLM (Этап 6+) -----------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
LLM_MAX_TOKENS=8000
LLM_BATCH_SIZE=40
LLM_USE_BATCH_API=true
LLM_ENABLED=true

# --- Лимиты ------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_RPM=60
